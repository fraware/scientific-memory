{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-memory.local/schemas/pcs/benchmark/PcsBenchIngest.v0.schema.json",
  "title": "PcsBenchIngest.v0",
  "description": "Canonical pcs-bench ingest manifest for Scientific Memory rendering benchmark outputs.",
  "type": "object",
  "required": [
    "schema_version",
    "producer_id",
    "suite_id",
    "workflow_id",
    "benchmark_runs",
    "coverage_reports",
    "explain_quality_reports",
    "query_results",
    "rendering_reports",
    "source_repo",
    "source_commit",
    "signature_or_digest"
  ],
  "properties": {
    "schema_version": { "const": "v0" },
    "producer_id": { "const": "scientific-memory" },
    "suite_id": { "type": "string" },
    "workflow_id": { "type": "string", "const": "pcs.scientific_memory" },
    "passed": { "type": "boolean" },
    "benchmark_runs": { "type": "array", "items": { "type": "object" } },
    "coverage_reports": { "type": "array", "items": { "type": "object" } },
    "explain_quality_reports": { "type": "array", "items": { "type": "object" } },
    "query_results": { "type": "array", "items": { "type": "object" } },
    "rendering_reports": { "type": "array", "items": { "type": "object" } },
    "failure_summary": { "type": "object" },
    "failure_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "import_failed",
          "render_failed",
          "query_failed",
          "staleness_failed",
          "comparison_failed",
          "formal_failed"
        ]
      }
    },
    "source_repo": { "type": "string" },
    "source_commit": { "type": "string" },
    "signature_or_digest": { "type": "string", "pattern": "^sha256:" }
  },
  "additionalProperties": true
}
