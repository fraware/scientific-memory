{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcs.sentinelops.ci/schemas/LeanCheckResult.v0.schema.json",
  "title": "LeanCheckResult.v0",
  "type": "object",
  "required": [
    "schema_version",
    "check_result_id",
    "release_id",
    "obligation_set_id",
    "status",
    "lean_version",
    "checked_at",
    "checker",
    "checker_version",
    "results",
    "source_repo",
    "source_commit",
    "signature_or_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.defs.json#/$defs/schema_version" },
    "check_result_id": { "type": "string", "minLength": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "obligation_set_id": { "type": "string", "minLength": 1 },
    "status": { "$ref": "common.defs.json#/$defs/artifact_status" },
    "lean_version": { "type": "string", "minLength": 1 },
    "checked_at": { "$ref": "common.defs.json#/$defs/iso8601_datetime" },
    "checker": { "type": "string", "minLength": 1 },
    "checker_version": { "type": "string", "minLength": 1 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lean_check_entry" }
    },
    "pf_explain": { "type": ["string", "null"] },
    "source_repo": { "type": "string", "format": "uri" },
    "source_commit": { "$ref": "common.defs.json#/$defs/git_commit" },
    "signature_or_digest": { "$ref": "common.defs.json#/$defs/hex_digest" }
  },
  "$defs": {
    "lean_check_entry": {
      "type": "object",
      "required": [
        "obligation_id",
        "lean_theorem",
        "status",
        "source_artifacts",
        "result",
        "checked_at",
        "lean_version"
      ],
      "additionalProperties": false,
      "properties": {
        "obligation_id": { "type": "string", "minLength": 1 },
        "lean_theorem": { "type": "string", "minLength": 1 },
        "status": { "$ref": "common.defs.json#/$defs/artifact_status" },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "result": { "type": "string", "enum": ["passed", "failed"] },
        "checked_at": { "$ref": "common.defs.json#/$defs/iso8601_datetime" },
        "lean_version": { "type": "string", "minLength": 1 },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "responsible_component": { "type": "string" },
        "repair_hint": { "type": "string" },
        "pf_explain": { "type": "string" }
      }
    }
  }
}
