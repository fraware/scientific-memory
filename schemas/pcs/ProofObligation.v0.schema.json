{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcs.sentinelops.ci/schemas/ProofObligation.v0.schema.json",
  "title": "ProofObligation.v0",
  "type": "object",
  "required": [
    "schema_version",
    "obligation_set_id",
    "release_id",
    "release_candidate",
    "generated_at",
    "trust_boundary",
    "obligations",
    "source_repo",
    "source_commit",
    "signature_or_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.defs.json#/$defs/schema_version" },
    "obligation_set_id": { "type": "string", "minLength": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "release_candidate": { "type": "string", "minLength": 1 },
    "generated_at": { "$ref": "common.defs.json#/$defs/iso8601_datetime" },
    "trust_boundary": { "type": "string", "minLength": 1 },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/proof_obligation" }
    },
    "source_repo": { "type": "string", "format": "uri" },
    "source_commit": { "$ref": "common.defs.json#/$defs/git_commit" },
    "signature_or_digest": { "$ref": "common.defs.json#/$defs/hex_digest" }
  },
  "$defs": {
    "proof_obligation": {
      "type": "object",
      "required": [
        "obligation_id",
        "predicate",
        "lean_theorem",
        "trust_boundary_invariant",
        "source_artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "obligation_id": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "lean_theorem": { "type": "string", "minLength": 1 },
        "trust_boundary_invariant": { "type": "string", "minLength": 1 },
        "formal_scope": { "type": "string" },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
