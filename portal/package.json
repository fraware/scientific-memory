{
  "name": "scientific-memory-portal",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-search-index.mjs && next build",
    "test:pcs-contract": "node scripts/verify-pcs-read-model.mjs",
    "test:pcs-phase2-contract": "node scripts/verify-pcs-phase2-read-model.mjs ../corpus/pcs/claims/claim-pcs-qc-release-v0.1/read_model.json",
    "test:pcs-labtrust-phase2-contract": "node scripts/verify-pcs-phase2-read-model.mjs ../tests/pcs/fixtures/labtrust-release/.phase2-read-model.json",
    "test:pcs-tool-use-phase2-contract": "node scripts/verify-pcs-phase2-read-model.mjs ../tests/pcs/fixtures/tool-use-release/.phase2-read-model.json",
    "test:pcs-computation-phase2-contract": "node scripts/verify-pcs-phase2-read-model.mjs ../tests/pcs/fixtures/computation-release/.phase2-read-model.json",
    "test:pcs-computation-rejected-phase2-contract": "node scripts/verify-pcs-phase2-read-model.mjs ../tests/pcs/fixtures/computation-rejected-release/.phase2-read-model.json",
    "lint": "prettier --check \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" && tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@xyflow/react": "^12.3.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^19.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
