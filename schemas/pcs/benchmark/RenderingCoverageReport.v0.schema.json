{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-memory.local/schemas/pcs/benchmark/RenderingCoverageReport.v0.schema.json",
  "title": "RenderingCoverageReport.v0",
  "type": "object",
  "required": ["schema_version", "generated_at", "passed", "cases"],
  "properties": {
    "schema_version": { "const": "RenderingCoverageReport.v0" },
    "generated_at": { "type": "string" },
    "passed": { "type": "boolean" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "passed", "section_coverage"],
        "properties": {
          "case_id": { "type": "string" },
          "claim_id": { "type": "string" },
          "passed": { "type": "boolean" },
          "section_coverage": { "type": "object" },
          "render_metrics": { "type": "object" }
        }
      }
    }
  },
  "additionalProperties": true
}
